{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Whilo Trace",
  "version": "0.1.0",
  "identifier": "app.whilo.trace",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Whilo Trace",
        "width": 1320,
        "height": 860,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Whilo Labs",
    "homepage": "https://github.com/Whilo-Labs/whilo-trace",
    "copyright": "Copyright (c) 2026 Firat Baghirli",
    "license": "MIT OR Apache-2.0",
    "category": "Utility",
    "shortDescription": "Network path monitor: per-hop loss and latency",
    "longDescription": "Watch the network path to several hosts at once: per-hop loss and latency in real time, a timeline from 5 minutes to 24 hours, local history and a report for your ISP.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "Russian"]
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
